<odoo>
    <record
    id="view_ir_attachment_rule_search"
    model="ir.ui.view">
        <field name="name">ir.attachment.rule.view.search</field>
        <field name="model">ir.attachment.rule</field>
        <field
        name="arch"
        type="xml">
            <search string="Search Attachment Rules">
                <field name="model_id" />
                <field name="domain" />
                <field name="max_size" />
                <field name="min_size" />
            </search>
        </field>
    </record>
    <record
    id="view_ir_attachment_rule_form"
    model="ir.ui.view">
        <field name="name">ir.attachment.rule.view.form</field>
        <field name="model">ir.attachment.rule</field>
        <field
        name="arch"
        type="xml">
            <form string="Attachment Rule">
                <sheet>
                    <group>
                        <group>
                            <field
                            name="model_id"
                            string="Model" />
                            <field
                            name="domain"
                            string="Domain" />
                        </group>
                    </group>
                    <group>
                        <group string="Max Size">
                            <field name="max_size" />
<!--                            <field name="warn_max_size" />-->
<!--                            <field name="force_max_size" />-->
                            <field name="try_compress" />
                        </group>
                        <group string="Min Size">
                            <field name="min_size" />
<!--                            <field name="warn_min_size" />-->
<!--                            <field name="force_min_size" />-->
                        </group>
                        <group string="Extensions">
                            <field name="allowed_extensions" />
                            <field name="forbidden_extensions" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record
    id="view_ir_attachment_rule_tree"
    model="ir.ui.view">
        <field name="name">ir.attachment.rule.view.tree</field>
        <field name="model">ir.attachment.rule</field>
        <field
        name="arch"
        type="xml">
            <tree string="Attachment Rules">
                <field name="model_id" />
                <field name="domain" />
                <field name="max_size" />
                <field name="min_size" />
            </tree>
        </field>
    </record>
    <record
    id="ir_attachment_rule_window_action"
    model="ir.actions.act_window">
        <field name="name">Attachment Rules</field>
        <field name="res_model">ir.attachment.rule</field>
        <field name="view_mode">tree,form</field>
        <field
        name="help"
        type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage attachment rules.
            </p>
        </field>
    </record>
    <menuitem
    name="Attachment Rules"
    action="ir_attachment_rule_window_action"
    id="menu_ir_attachment_rule"
    parent="base.next_id_9" />
</odoo>
